<?xml version="1.0" encoding="UTF-8"?>

<settings>

    <!-- =================================================
         TIME DISPLAY
         ================================================= -->

    <setting
        propertyKey="@Properties.timeFormat"
        title="@Strings.TimeFormatTitle"
    >

        <settingConfig type="list">

            <listEntry value="0">
                Follow Watch Settings
            </listEntry>

            <listEntry value="1">
                12 Hour
            </listEntry>

            <listEntry value="2">
                24 Hour
            </listEntry>

        </settingConfig>

    </setting>


    <!-- =================================================
         STEP GOAL
         ================================================= -->

    <setting
        propertyKey="@Properties.stepGoal"
        title="@Strings.StepGoalTitle"
    >

        <settingConfig type="list">

            <listEntry value="3000">
                3,000 Steps
            </listEntry>

            <listEntry value="5000">
                5,000 Steps
            </listEntry>

            <listEntry value="7500">
                7,500 Steps
            </listEntry>

            <listEntry value="10000">
                10,000 Steps
            </listEntry>

            <listEntry value="12500">
                12,500 Steps
            </listEntry>

            <listEntry value="15000">
                15,000 Steps
            </listEntry>

        </settingConfig>

    </setting>

</settings>